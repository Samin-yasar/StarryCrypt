# EditorConfig helps maintain consistent coding styles for multiple developers
# working on the same project across various editors and IDEs

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript, TypeScript, JSX, TSX
[*.{js,jsx,ts,tsx,mjs,mts}]
indent_style = space
indent_size = 2
max_line_length = 100

# JSON, JSONC
[*.json]
indent_style = space
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
max_line_length = off
trim_trailing_whitespace = false

# Markdown files (fix formatting)
[*.markdown]
max_line_length = off
trim_trailing_whitespace = false

# CSS, SCSS, Less
[*.{css,scss,less}]
indent_style = space
indent_size = 2

# HTML
[*.{html,htm}]
indent_style = space
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

# Dockerfile
[Dockerfile]
indent_style = space
indent_size = 2

# dotenv files
[.env*]
indent_style = space
indent_size = 2
